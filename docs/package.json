{
  "name": "docs",
  "private": true,
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.4",
    "jsdoc-to-markdown": "9.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-styleguidist": "13.1.4",
    "typescript": "5.9.3",
    "url-loader": "4.1.1",
    "webpack": "5.109.2"
  },
  "overrides": {
    "brace-expansion": "1.1.16",
    "markdown-to-jsx": "7.4.0",
    "minimatch": "3.1.3",
    "prismjs": "1.30.0",
    "react-dev-utils": {
      "fork-ts-checker-webpack-plugin": "9.1.0"
    },
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  },
  "scripts": {
    "build:hooks": "jsdoc2md ../src/hooks/*.js > ./hooks.md",
    "build": "npm run build:hooks && cd .. && ./docs/node_modules/.bin/styleguidist build --config ./docs/styleguide.config.js",
    "dev": "npm run build:hooks -- --watch & styleguidist server"
  }
}
